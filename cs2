<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<title>CS Strike - 3D Shooter</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { overflow: hidden; background: #000; font-family: 'Arial', sans-serif; color: #fff; }
  canvas { display: block; }

  #crosshair {
    position: fixed; top: 50%; left: 50%;
    width: 24px; height: 24px;
    transform: translate(-50%, -50%);
    pointer-events: none; z-index: 10;
  }
  #crosshair::before, #crosshair::after {
    content: ''; position: absolute; background: rgba(0, 255, 128, 0.9);
    box-shadow: 0 0 4px rgba(0,255,128,0.8);
  }
  #crosshair::before { left: 50%; top: 0; width: 2px; height: 10px; transform: translateX(-50%); }
  #crosshair::after { top: 50%; left: 0; height: 2px; width: 10px; transform: translateY(-50%); }
  .ch-right::before { left: auto; right: 0; }
  .ch-bottom::after { top: auto; bottom: 0; }

  #hud {
    position: fixed; bottom: 0; left: 0; right: 0;
    padding: 20px 30px;
    background: linear-gradient(180deg, transparent, rgba(0,0,0,0.7));
    display: flex; justify-content: space-between; align-items: flex-end;
    pointer-events: none; z-index: 10;
    font-weight: bold;
  }
  .hud-block {
    display: flex; flex-direction: column; gap: 4px;
    text-shadow: 0 2px 8px rgba(0,0,0,0.8);
  }
  .hud-label { font-size: 12px; color: #aaa; letter-spacing: 2px; text-transform: uppercase; }
  .hud-value { font-size: 36px; font-family: 'Courier New', monospace; }
  #health-val { color: #ff4444; }
  #ammo-val { color: #ffcc00; }
  #score-val { color: #44ff88; }
  #kills-val { color: #ff8844; }

  #health-bar {
    width: 200px; height: 6px;
    background: rgba(255,255,255,0.1);
    border-radius: 3px; overflow: hidden;
    margin-top: 4px;
  }
  #health-fill {
    height: 100%; background: linear-gradient(90deg, #ff4444, #ff8844);
    width: 100%; transition: width 0.3s;
  }

  #hitmarker {
    position: fixed; top: 50%; left: 50%;
    width: 30px; height: 30px;
    transform: translate(-50%, -50%);
    pointer-events: none; z-index: 11;
    opacity: 0; transition: opacity 0.1s;
  }
  #hitmarker.show { opacity: 1; }
  #hitmarker::before, #hitmarker::after {
    content: ''; position: absolute;
    width: 10px; height: 2px; background: #fff;
    box-shadow: 0 0 6px #fff;
  }
  #hitmarker::before { top: 14px; left: 0; transform: rotate(45deg); transform-origin: right center; }
  #hitmarker::after { top: 14px; right: 0; transform: rotate(-45deg); transform-origin: left center; }

  #damage-overlay {
    position: fixed; inset: 0;
    pointer-events: none; z-index: 9;
    box-shadow: inset 0 0 200px rgba(255,0,0,0);
    transition: box-shadow 0.2s;
  }
  #damage-overlay.hit { box-shadow: inset 0 0 200px rgba(255,0,0,0.6); }

  #start-screen, #game-over {
    position: fixed; inset: 0;
    background: radial-gradient(ellipse at center, rgba(20,30,40,0.95), rgba(0,0,0,0.98));
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    z-index: 100;
    backdrop-filter: blur(8px);
  }
  #game-over { display: none; }
  .title {
    font-size: 96px; font-weight: 900;
    background: linear-gradient(135deg, #ff8800, #ff4400, #ffaa00);
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: 8px;
    text-shadow: 0 0 60px rgba(255,100,0,0.5);
    margin-bottom: 10px;
  }
  .subtitle {
    font-size: 18px; color: #888;
    letter-spacing: 4px; margin-bottom: 50px;
  }
  .controls {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    padding: 25px 40px; border-radius: 8px;
    margin-bottom: 40px;
    font-size: 14px; line-height: 2;
    color: #ccc;
  }
  .controls b { color: #ffaa00; font-family: monospace; background: rgba(0,0,0,0.4); padding: 2px 8px; border-radius: 3px; }
  .btn {
    padding: 18px 60px; font-size: 20px; font-weight: bold;
    background: linear-gradient(135deg, #ff6600, #ff3300);
    color: white; border: none; border-radius: 4px;
    cursor: pointer; letter-spacing: 3px;
    box-shadow: 0 4px 20px rgba(255,80,0,0.4);
    transition: all 0.2s;
    text-transform: uppercase;
  }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 6px 30px rgba(255,80,0,0.6); }
  .btn:active { transform: translateY(0); }

  #reload-indicator {
    position: fixed; top: 55%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 16px; color: #ffcc00;
    letter-spacing: 2px; font-weight: bold;
    text-shadow: 0 0 10px rgba(255,200,0,0.8);
    display: none; z-index: 10;
  }

  #wave-info {
    position: fixed; top: 30px; left: 50%;
    transform: translateX(-50%);
    font-size: 14px; color: #aaa;
    letter-spacing: 3px; z-index: 10;
    text-shadow: 0 2px 4px rgba(0,0,0,0.8);
  }

  #kill-feed {
    position: fixed; top: 20px; right: 20px;
    display: flex; flex-direction: column; gap: 6px;
    z-index: 10; pointer-events: none;
  }
  .kill-msg {
    background: rgba(0,0,0,0.6);
    padding: 6px 12px; border-radius: 3px;
    font-size: 13px; border-left: 3px solid #ff4444;
    animation: slideIn 0.3s ease-out;
  }
  @keyframes slideIn { from { transform: translateX(100px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

  .final-stats {
    font-size: 20px; margin: 20px 0 30px;
    text-align: center; line-height: 1.8;
  }
  .final-stats span { color: #ffaa00; font-size: 28px; font-weight: bold; }
</style>
</head>
<body>

<div id="crosshair"></div>
<div id="hitmarker"></div>
<div id="damage-overlay"></div>
<div id="reload-indicator">ПЕРЕЗАРЯДКА...</div>
<div id="wave-info">ВОЛНА 1</div>
<div id="kill-feed"></div>

<div id="hud">
  <div class="hud-block">
    <div class="hud-label">Здоровье</div>
    <div class="hud-value" id="health-val">100</div>
    <div id="health-bar"><div id="health-fill"></div></div>
  </div>
  <div class="hud-block" style="align-items: center;">
    <div class="hud-label">Счёт</div>
    <div class="hud-value" id="score-val">0</div>
    <div class="hud-label" style="margin-top:8px;">Убийства</div>
    <div class="hud-value" id="kills-val" style="font-size:24px;">0</div>
  </div>
  <div class="hud-block" style="align-items: flex-end;">
    <div class="hud-label">Патроны</div>
    <div class="hud-value"><span id="ammo-val">30</span> <span style="font-size:20px;color:#888;">/ <span id="reserve-val">90</span></span></div>
  </div>
</div>

<div id="start-screen">
  <div class="title">CS STRIKE</div>
  <div class="subtitle">TACTICAL SHOOTER</div>
  <div class="controls">
    <div><b>W A S D</b> — движение</div>
    <div><b>SHIFT</b> — бег</div>
    <div><b>МЫШЬ</b> — обзор</div>
    <div><b>ЛКМ</b> — стрельба</div>
    <div><b>R</b> — перезарядка</div>
    <div><b>ESC</b> — пауза</div>
  </div>
  <button class="btn" id="start-btn">НАЧАТЬ БОЙ</button>
</div>

<div id="game-over">
  <div class="title" style="font-size:72px;">ПОРАЖЕНИЕ</div>
  <div class="final-stats">
    Счёт: <span id="final-score">0</span><br>
    Убийств: <span id="final-kills">0</span><br>
    Волна: <span id="final-wave">1</span>
  </div>
  <button class="btn" id="restart-btn">ИГРАТЬ СНОВА</button>
</div>

<script type="importmap">
